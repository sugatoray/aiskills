#!/usr/bin/env python3
"""
flight-status — one-shot or repeating flight status reports with a composite
report card (journey % by distance + route map) and an Eastern-timestamped
announcement.

Signature:
    /flight-status --flight=<flight-number> [--repeat=<30mins|1h|...>]
                    [--start-datetime="<yyyy-mm-dd HH:MM:SS>"]
                    [--out-dir=<dir>] [--map-keep-name=<file>]

Outputs (into --out-dir):
    <flight>-card.html   composite report card (dashboard + full-width map)
    <flight>-map.png     latest good route map render
    report.json          machine-readable summary
Plus the announcement text on stdout.

With --repeat, the run still performs one check; repeating on a schedule is
the caller's job (see SKILL.md).
"""
import argparse
import base64
import json
import math
import os
import re
import shutil
import struct
import subprocess
import sys
import zlib
from datetime import datetime
from zoneinfo import ZoneInfo

FLIGHTAWARE = "/opt/hatch/bin/flightaware"

