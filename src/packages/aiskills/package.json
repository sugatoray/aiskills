{
  "name": "@sugatoray-ai/aiskills",
  "version": "0.2.0",
  "description": "Sugato Ray's curated agent skills (scrolls, stata, personas, ...) vendored as an npm package and registered with `npx skills add` on install.",
  "keywords": [
    "agent-skills",
    "skills",
    "claude-code",
    "codex",
    "ai",
    "scrolls"
  ],
  "homepage": "https://github.com/sugatoray/aiskills#readme",
  "bugs": {
    "url": "https://github.com/sugatoray/aiskills/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sugatoray/aiskills.git",
    "directory": "src/packages/aiskills"
  },
  "license": "MIT",
  "author": "Sugato Ray (https://github.com/sugatoray)",
  "type": "module",
  "bin": {
    "aiskills": "bin/aiskills.mjs",
    "ais": "bin/aiskills.mjs",
    "aix": "bin/aix.mjs"
  },
  "files": [
    "bin/",
    "src/scripts/cli.mjs",
    "src/scripts/installer.mjs",
    "src/scripts/postinstall.mjs",
    "skills/",
    ".claude-plugin/marketplace.json",
    ".aiskills/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "vendor": "node src/scripts/vendor-skills.mjs",
    "clean": "node src/scripts/vendor-skills.mjs --clean",
    "docs:skills": "node src/scripts/build-skills-docs.mjs",
    "docs:html": "node src/scripts/build-docs-html.mjs docs/docsite --out docs/docsite/index.html",
    "banner": "node src/scripts/create-banner.mjs",
    "banner:check": "node src/scripts/create-banner.mjs --check",
    "banner:png": "node src/scripts/create-banner.mjs --png",
    "docs": "npm run banner && npm run docs:skills && python3 ../../../skills/docs/create-lib-docs/scripts/build_llms_txt.py docs/docsite && npm run docs:html",
    "prepack": "node src/scripts/vendor-skills.mjs",
    "postinstall": "node src/scripts/postinstall.mjs",
    "pack:dry": "npm pack --dry-run",
    "test": "node --test src/test/*.test.mjs",
    "test:e2e": "AISKILLS_E2E=1 node --test src/test/e2e.test.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  }
}
