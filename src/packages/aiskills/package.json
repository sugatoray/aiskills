{
  "name": "@sugatoray-ai/aiskills",
  "version": "0.1.0",
  "description": "Sugato Ray's curated agent skills (scrolls, stata, personas, ...) vendored as an npm package and registered with `npx skills add` on install.",
  "keywords": [
    "agent-skills",
    "skills",
    "claude-code",
    "codex",
    "ai",
    "scrolls"
  ],
  "homepage": "https://github.com/sugatoray/aiskills#readme",
  "bugs": {
    "url": "https://github.com/sugatoray/aiskills/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sugatoray/aiskills.git",
    "directory": "src/packages/aiskills"
  },
  "license": "MIT",
  "author": "Sugato Ray (https://github.com/sugatoray)",
  "type": "module",
  "bin": {
    "aiskills": "src/aiskills/cli.mjs"
  },
  "files": [
    "src/aiskills/cli.mjs",
    "src/aiskills/installer.mjs",
    "src/aiskills/postinstall.mjs",
    "skills/",
    ".claude-plugin/marketplace.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "vendor": "node src/aiskills/vendor-skills.mjs",
    "clean": "node src/aiskills/vendor-skills.mjs --clean",
    "prepack": "node src/aiskills/vendor-skills.mjs",
    "postinstall": "node src/aiskills/postinstall.mjs",
    "pack:dry": "npm pack --dry-run",
    "test": "node --test src/aiskills/test/*.test.mjs",
    "test:e2e": "AISKILLS_E2E=1 node --test src/aiskills/test/e2e.test.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  }
}
